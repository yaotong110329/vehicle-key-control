{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vehicle Key Control",
  "version": "1.0.0",
  "identifier": "tw.vehiclekeycontrol.desktop",
  "build": {
    "beforeBuildCommand": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./prepare-tauri-dist.ps1",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:8080"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "車輛鑰匙控管",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "maximized": true,
        "fullscreen": false,
        "decorations": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
